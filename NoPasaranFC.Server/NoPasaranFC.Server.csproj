<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <!-- The referenced game project also publishes its prebuilt content. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoPasaranFC.csproj" />
  </ItemGroup>

  <!-- The dedicated server only needs the seed catalog (no graphics/content). -->
  <ItemGroup>
    <None Include="..\Database\teams_seed.json"
          Link="Database\teams_seed.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
